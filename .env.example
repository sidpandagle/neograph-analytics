# Resend — email delivery (https://resend.com/api-keys)
# Domain neographanalytics.com must be verified in Resend dashboard to send from support@neographanalytics.com
RESEND_API_KEY=your_resend_api_key_here

# API Configuration
# Base URL for the backend API (reports, forms, search, categories)
# For local development: http://127.0.0.1:8080
# For production: https://your-api-domain.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# Admin submissions page (/admin/submissions)
# Comma-separated allowlist. A Supabase Auth account alone is NOT enough — the
# signed-in email must appear here, and with this unset the admin API denies
# everyone. Create the account itself in Supabase > Authentication > Users.
ADMIN_EMAILS=you@neographanalytics.com

# ntfy — new-submission alerts. With NTFY_TOPIC unset, notifications are
# skipped and the form still succeeds. A public ntfy.sh topic is readable by
# anyone who knows its name and the alert carries a lead's name and email, so
# use an unguessable topic, or a self-hosted server with NTFY_TOKEN.
NTFY_TOPIC=                   # e.g. neograph-leads-7f3a2c
NTFY_SERVER=https://ntfy.sh   # override for a self-hosted instance
NTFY_TOKEN=                   # optional tk_… token for a protected topic

# Absolute site URL, used for the deep link inside the Pushover notification.
NEXT_PUBLIC_SITE_URL=https://www.neographanalytics.com
