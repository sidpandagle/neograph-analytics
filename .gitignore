# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# A build whose output will be used as evidence is run with the previous
# .next moved aside (`mv .next .next.<label>`), because `next build` on a
# warm cache has three times emitted the previous build's HTML and caused a
# false pass. Those set-asides are build output too, and are never deleted
# by this repo's tooling -- remove them by hand when the disk is wanted.
/.next.*/

# Throwaway one-off scripts. They live in scripts/ rather than the scratchpad
# because node resolves node_modules from the file's directory upward, so a
# script importing @supabase/supabase-js has to sit inside the repo to run at
# all. Anything worth keeping gets a name without the underscore and a
# docstring saying why it exists.
scripts/_*.mjs
scripts/_*.py

/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local secrets (non-dot variant used by this project)
/env
/env.*
!/.env.example
.og-preview/
.pr-body.md
.perf/
